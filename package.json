{
  "name": "pi-archimedes-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "meta"
  ],
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "preinstall": "node -e \"if (!/pnpm/.test(process.env.npm_execpath || '')) { console.error('\\n  This project uses pnpm. Please use: pnpm install\\n'); process.exit(1); }\"",
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "meta/src/index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "fast-check": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
